{
  "root": true,
  "extends": ["@react-native/community", "prettier"],
  "plugins": ["prettier"],
  "rules": {
    "prettier/prettier": "error",
    "react-native/no-unused-styles": "warn",
    "react-native/split-platform-components": "off"
  },
  "ignorePatterns": ["node_modules/", ".expo/", "android/", "coverage/"]
}
